# Copy to .env and start with: node --env-file=.env backend/src/server.js
PORT=5000
# Built React app served by `npm start` (default web/dist).
# PUBLIC_DIR=web/dist
LIBRARY_NAME=Central Library
# Admin access: generate all four with `npm run admin:hash -- --generate`.
# Production refuses to start without them (or set ADMIN_DISABLED=true).
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_PATH=
SESSION_SECRET=
DB_PATH=./data/library.db
MAX_UPLOAD_MB=10
# Only needed if a frontend on another origin calls this API.
CORS_ORIGIN=
# Load backend/sample-data/sample-books.csv when the database is empty.
# Defaults to true in development, false when NODE_ENV=production.
AUTO_LOAD_SAMPLE=true
# true behind Render/Railway/Nginx so rate limits see real client IPs.
TRUST_PROXY=false
