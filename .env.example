# Copy to .env (same folder); `npm start` reads it automatically.
NODE_ENV=production
# Plain http (localhost / library network): keep false. Set true only behind HTTPS.
SECURE_COOKIES=false
PORT=5000
# Built React app served by `npm start` (default web/dist).
# PUBLIC_DIR=web/dist
LIBRARY_NAME=Central Library
# Admin access: generate all three with `npm run admin:hash -- --generate`.
# Production refuses to start without them (or set ADMIN_DISABLED=true).
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
DB_PATH=./data/library.db
MAX_UPLOAD_MB=10
# Only needed if a frontend on another origin calls this API.
CORS_ORIGIN=
# Load backend/sample-data/catalogue.xlsx when the database is empty.
# Defaults to true in development, false when NODE_ENV=production.
AUTO_LOAD_SAMPLE=false
# true behind Render/Railway/Nginx so rate limits see real client IPs.
TRUST_PROXY=false
# Hit counter on Vercel: Upstash Redis (Vercel → Storage). Server-side only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Admin → Support tab (read at build time; leave empty until known).
VITE_SUPPORT_NAME=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_SUPPORT_HOURS=Mon–Sat, 10 AM – 7 PM IST
VITE_SUPPORT_RESPONSE=Within 24 hours
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xdeepoow
